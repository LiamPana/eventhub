# Flask
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=secret-key

# MySQL (usate da docker-compose per creare il database)
MYSQL_ROOT_PASSWORD= la-tua-password
MYSQL_DATABASE=eventhub
MYSQL_USER=eventhub
MYSQL_PASSWORD=la-tua-password
MYSQL_PORT=3306

# Connessione di Flask (deve usare gli stessi valori di sopra)
DATABASE_URL=mysql+pymysql://eventhub:la-tua-password@localhost:3306/eventhub?charset=utf8mb4